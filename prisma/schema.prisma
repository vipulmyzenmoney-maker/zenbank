generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SyllabusPack {
  id         BigInt     @id @default(autoincrement())
  title      String     @db.VarChar(255)
  gradeLevel String     @db.VarChar(50) @map("grade_level")
  subject    String     @db.VarChar(100)
  topics     Json       @default("[]")
  createdAt  DateTime   @default(now()) @map("created_at")
  questions  Question[]

  @@map("syllabus_packs")
}

model Question {
  id             BigInt        @id @default(autoincrement())
  syllabusPackId BigInt?       @map("syllabus_pack_id")
  questionText   String        @map("question_text")
  options        Json
  correctAnswer  String        @map("correct_answer")
  explanation    String
  gradeLevel     String        @map("grade_level")
  subject        String
  topic          String        @default("")
  difficulty     String        @default("medium")
  confidence     Int           @default(95)
  status         String        @default("draft")
  flagReason     String?       @map("flag_reason")
  verifiedAt     DateTime?     @map("verified_at")
  verifiedBy     String?       @map("verified_by")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  syllabusPack   SyllabusPack? @relation(fields: [syllabusPackId], references: [id], onDelete: SetNull)

  analytics      QuestionAnalytics?

  @@index([status])
  @@index([gradeLevel, subject, topic])
  @@index([gradeLevel, status])
  @@map("questions")
}

model QuestionAnalytics {
  questionId       BigInt    @id @map("question_id")
  timesServed      Int       @default(0) @map("times_served")
  timesCorrect     Int       @default(0) @map("times_correct")
  timesIncorrect   Int       @default(0) @map("times_incorrect")
  accuracyRate     Decimal   @default(0.00) @map("accuracy_rate") @db.Decimal(5, 2)
  avgTimeSeconds   Decimal   @default(0.00) @map("avg_time_seconds") @db.Decimal(6, 2)
  isAutoFlagged    Boolean   @default(false) @map("is_auto_flagged")
  lastServedAt     DateTime? @map("last_served_at") @db.Timestamptz(6)

  question         Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("question_analytics")
}
