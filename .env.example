# =============================================================================
# ZenBank Engine - Environment Variables
# =============================================================================

PORT=3001
NODE_ENV=production

# PostgreSQL Connection String
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zenbank?schema=public"

# Groq API Key for AI Question Generation
GROQ_API_KEY=gsk_your_groq_api_key_here

# Internal & Public URLs
MYZENLEARNING_URL=http://localhost:3000
NEXT_PUBLIC_MYZENLEARNING_URL=http://localhost:3000
